          "routine": "      REAL*4 FUNCTION average (nulist,list)\r\n      IMPLICIT  NONE\r\n!\r\n      INTEGER*4       nulist\r\n      REAL*4          list(nulist)\r\n      INTEGER*4       kk\r\n!\r\n      IF (nulist .GT. 1) THEN\r\n         DO kk = 1,nulist\r\n            average = average + list(kk)\r\n         ENDDO\r\n         average = average/nulist\r\n      ELSEIF (nulist.EQ.1) THEN\r\n         average = list(1)\r\n      ELSE\r\n         average = -9999.\r\n      ENDIF\r\n      RETURN\r\n!\r\n      END\r\n\r",
