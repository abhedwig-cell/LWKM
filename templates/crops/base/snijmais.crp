**********************************************************************************
* Contents: SWAP 4 - Crop data (dynamic crop growth)
**********************************************************************************
* Comment area:
*
* crop:    maize; Zea mays
* source:  https://github.com/ajwdewit/WOFOST_crop_parameters
*          maize (Fodder_maize_nl)
* region:  NW Europe, Netherlands
* version: 1.0.0
* rights:  European Union Public License (EUPL)
*
**********************************************************************************

*** PLANT GROWTH SECTION ***

**********************************************************************************
* Part 0 : Preparation, Sowing, Germination and Harvest

* Part 0a: Preparation before crop growth

* Switch for preparation (default SWPREP=0):
  SWPREP = 0                 ! 0 = No preparation
                             ! 1 = Preparation before start of crop growth

* Part 0b: Sowing

* Switch for sowing (default SWSOW=0):
  SWSOW = 0                  ! 0 = No sowing
                             ! 1 = Sowing before start of crop growth

* Part 0c: Germination
  
* Switch for germination:
  SWGERM = 2                 ! 0 = No germination
                             ! 1 = Simulate germination depending on temperature
                             ! 2 = Simulate germination depending on temperature and hydrological conditions

* If SWGERM=2, specify:
  TSUMEMEOPT = 110.0         ! Temperature sum needed for crop emergence [0..1000 degrees C, R]
  TBASEM = 4.0               ! Minimum temperature, used for germination trajectory [0..40 degrees C, R]  
  TEFFMX = 30.0              ! Maximum temperature, used for germination trajectory [0..40 degrees C, R]  
  HDRYGERM = -500.0          ! Pressure head rootzone for dry germination trajectory [-1000..-0.01 cm, R]
  HWETGERM = -100.0          ! Pressure head rootzone for wet germination trajectory [-100..-0.01 cm, R]
  ZGERM = -10.0              ! Soil depth for monitoring average pressure head [-100..0 cm, R]
  AGERM = 203.0              ! A-coefficient Eq. 24/25 Feddes and Van Wijk (1988) [1..1000, R]

* Part 0d: Harvest

  DVSEND = 2.0               ! Development stage at harvest [0..3 -, R]

* Switch for timing of harvest:
  SWHARV = 0                 ! 0 = Timing of harvest depends on end of growing period (CROPEND)
                             ! 1 = Timing of harvest depends on development stage (DVSEND)

**********************************************************************************

**********************************************************************************
* Part 1: Crop factor or crop height

* Choose between crop factor and crop height
* Choose crop factor if ETref is used, either from meteo input file (SWETR=1) or with Penman-Monteith
* Choose crop height if Penman-Monteith should be used with actual crop height, albedo and canopy resistance
  SWCF = 2                   ! 1 = Crop factor 
                             ! 2 = Crop height

* If SWCF=2, list crop height [0..1.d4 cm, R], as function of development stage [0..2 -, R]:
  CHTB =
  0.0 5.0
  0.3 20.0
  0.5 40.0
  0.8 80.0
  1.3 265.0
  2.0 300.0
* End of table

* If SWCF=2, in addition to crop height list crop specific values for:
  ALBEDO = 0.2               ! Crop reflection coefficient [0..1.0 -, R]                    
*  RSC = 196.1                ! Minimum canopy resistance [0..1d6 s/m, R]
  RSC = 250.                ! Minimum canopy resistance [0..1d6 s/m, R]
  RSW = 0.0                  ! Canopy resistance of intercepted water [0..1d6 s/m, R]

**********************************************************************************

**********************************************************************************
* Part 2 : Crop development

* Switch for type of WOFOST crop development (default SWWOFOST=1):
  SWWOFOST = 1               ! 1 = WOFOST
                             ! 2 = WOFOST soybeans
                             ! 3 = WOFOST grass

* In case of WOFOST (SWWOFOST=1), specify:
* Switch for crop development before anthesis:
  IDSL = 0                   ! 0 = Depends on temperature
                             ! 1 = Depends on temperature and daylength
                             ! 2 = Depends on temperature, daylength and vernalisation factor

* Specify temperature dependency:
  TSUMEA = 600.0             ! Temperature sum from emergence to anthesis [0..10000 degrees C, R]
  TSUMAM = 1211.0            ! Temperature sum from anthesis to maturity  [0..10000 degrees C, R]

* List increase in temperature sum [0..60 degrees C, R] as function of daily average temperature [0..100 degrees C, R]
*   TAV  DTSM
  DTSMTB =
  0.0 0.0
  6.0 0.0
  30.0 24.0
  35.0 24.0
* End of table

**********************************************************************************

**********************************************************************************
* Part 3: Initial values

  TDWI = 50.0                ! Initial total crop dry weight [0..10000 kg/ha, R]
  RGRLAI = 0.0294            ! Maximum relative increase in LAI [0..1 m2/m2/d, R]

**********************************************************************************

**********************************************************************************
* Part 4: Green surface area

  SPA = 0.0                  ! Specific pod area [0..1 ha/kg, R]
  SSA = 0.0                  ! Specific stem area [0..1 ha/kg, R]
  SPAN = 40.0                ! Life span under leaves under optimum conditions [0..366 d, R]
  TBASE = 10.0               ! Lower threshold temperature for ageing of leaves [-10..30 degrees C, R]

* List specific leaf area [0..1 ha/kg, R] as function of crop development stage [0..2 -, R]
*   DVS  SLA
  SLATB =
  0.00 0.0032
  0.78 0.0012
  2.00 0.0012
* End of table 

**********************************************************************************

**********************************************************************************
* Part 5: Assimilation

  KDIF = 0.62                ! Extinction coefficient for diffuse visible light [0..2 -, R]
  KDIR = 0.75                ! Extinction coefficient for direct visible light  [0..2 -, R]
  EFF = 0.47                 ! Light use efficiency for real leaf [0..10 kg/ha/hr/(Jm2s), R]
  CFRDM = 0.4                ! Carbon fraction in dry matter (default = 0.4) [0..1 kg C/kg MD, R]

* List maximum CO2 assimilation rate [0..100 kg/ha/hr, R] as function of development stage [0..2 -, R]
*   DVS  AMAX
  AMAXTB =
  0.00 70.0
  1.25 70.0
  1.50 63.0
  1.75 49.0
  2.00 35.0
* End of table 

* List reduction factor of AMAX [-, R] as function of average day temperature [-10..50 degrees C, R]
*   TAVD  TMPF
  TMPFTB =
  0.0 0.01
  9.0 0.05
  16.0 0.80
  18.0 0.94
  20.0 1.00
  30.0 1.00
  36.0 0.95
  42.0 0.56
* End of table 

* List reduction factor of AMAX [-, R] as function of minimum day temperature [-10..50 degrees C, R]
*   TMNR  TMNF
  TMNFTB =
  5.0 0.0
  8.0 1.0
* End of table 

**********************************************************************************

**********************************************************************************
* Part 6: Conversion of assimilates into biomass

  CVR = 0.69                 ! Efficiency of conversion into roots [0..1 kg/kg, R]
  CVS = 0.66                 ! Efficiency of conversion into stems [0..1 kg/kg, R]
  CVL = 0.68                 ! Efficiency of conversion into leaves [0..1 kg/kg, R]
  CVO = 0.67                 ! Efficiency of conversion into storage organs [0..1 kg/kg, R]

**********************************************************************************

**********************************************************************************
* Part 7: Maintenance respiration

  Q10 = 2.0                  ! Increase in respiration rate with temperature  [0..5 /10 degrees C, R]
  RML = 0.03                 ! Maintenance respiration rate of leaves [0..1 kgCH2O/kg/d, R]
  RMO = 0.01                 ! Maintenance respiration rate of storage organs [0..1 kgCH2O/kg/d, R]
  RMR = 0.015                ! Maintenance respiration rate of roots [0..1 kgCH2O/kg/d, R]
  RMS = 0.015                ! Maintenance respiration rate of stems [0..1 kgCH2O/kg/d, R]

* List reduction factor of senescence [-, R] as function of development stage [0..2 -, R]
*   DVS  RFSE
  RFSETB = 
  0.00 1.00
  1.50 1.00
  1.75 0.75
  2.00 0.25
* End of table 

**********************************************************************************

**********************************************************************************
* Part 8: Partitioning

* List fraction of total dry matter increase partitioned to the roots [kg/kg, R]
* as function of development stage [0..2 -, R]
*   DVS  FR
  FRTB = 
  0.0 0.40
  0.1 0.37
  0.2 0.34
  0.3 0.31
  0.4 0.27
  0.5 0.23
  0.6 0.19
  0.7 0.15
  0.8 0.10
  0.9 0.06
  1.0 0.00
  2.0 0.00
* End of table 

* List fraction of total above ground dry matter increase partitioned to the leaves [kg/kg, R]
* as function of development stage [0..2 -, R]
*   DVS  FL
  FLTB = 
  0.00 0.62
  0.33 0.62
  0.88 0.15
  0.95 0.15
  1.10 0.10
  1.20 0.00
  2.00 0.00
* End of table 

* List fraction of total above ground dry matter increase partitioned to the stems [kg/kg, R]
* as function of development stage [0..2 -, R]
*   DVS  FS
  FSTB = 
  0.00 0.38
  0.33 0.38
  0.88 0.85
  0.95 0.85
  1.10 0.40
  1.20 0.00
  2.00 0.00
* End of table 

* List fraction of total above ground dry matter increase partitioned to the storage organs [kg/kg, R]
* as function of development stage [0..2 -, R]
*   DVS  FO
  FOTB = 
  0.95 0.0
  1.10 0.5
  1.20 1.0
  2.00 1.0
* End of table

**********************************************************************************

**********************************************************************************
* Part 9: Death rates

  PERDL = 0.03               ! Maximum relative death rate of leaves due to water stress [0..3 /d, R]

* List relative death rates of roots [kg/kg/d] as function of development stage [0..2 -, R]
*   DVS  RDRR
  RDRRTB = 
  0.00 0.00
  1.50 0.00
  1.51 0.02
  2.00 0.02
* End of table

* List relative death rates of stems [kg/kg/d] as function of development stage [0..2 -, R]
*   DVS  RDRS
  RDRSTB = 
  0.00 0.00
  1.50 0.00
  1.51 0.02
  2.00 0.02
* End of table

**********************************************************************************

**********************************************************************************
* Part 10: Root development

* Switch development of root depth
  SWRD = 2                   ! 1 = Root depth depends on development stage
                             ! 2 = Root depth depends on maximum daily increase
                             ! 3 = Root depth depends on available root biomass

* If case of dependency maximum daily increase (SWRD=2), specify:
  RDI = 10.0                 ! Initial rooting depth [0..1000 cm, R]
  RRI = 2.2                  ! Maximum daily increase in rooting depth [0..100 cm/d, R]
  RDC = 100.0                ! Maximum rooting depth of particular crop [0..1000 cm, R]

* Switch for calculation rooting depth:
  SWDMI2RD = 1               ! 0 = Rooting depth increase is related to availability assimilates for roots
                             ! 1 = Rooting depth increase is related to relative dry matter increase
                             ! 2 = Rooting depth increase is related to drought stress

* Always specify:
* Switch for calculation of relative root density (default SWRDC=1):
  SWRDC = 0                  ! 0 = Root density is not modified
                             ! 1 = Root density is modified based on root water extraction

* List relative root density distribution [0..1 -, R] as function of relative rooting depth [0..1 -, R].
* This defines the shape of the root distribution, for example, uniform, linear or exponential.
*   RRD  RDENS
  RDCTB =
  0.0 1.0
  1.0 0.0
* End of table

* In case of SWDROUGHT=2 or SWDROUGHT=3 or SWOXYGEN=2, specify:
  SRL = 151375.0             ! Specific root length [0.0..1.d10 m root/kg root, R]
  ROOTRADIUS = 0.015         ! Root radius [1d-4..1 cm, R]

**********************************************************************************

**********************************************************************************
* Part 11: Oxygen stress

* Switch for oxygen stress:
  SWOXYGEN = 2               ! 0 = No oxygen stress
                             ! 1 = Oxygen stress according to Feddes et al. (1978)
                             ! 2 = Oxygen stress according to Bartholomeus et al. (2008)

* Switch for checking aerobic conditions in root zone to stop root(zone) development
  SWWRTNONOX = 1             ! 0 = Do not check for aerobic conditions
                             ! 1 = Check for aerobic conditions

  AERATECRIT = 0.5           ! Threshold to stop root extension in case of oxygenstress; 0.0 maximum oxygen stress [0.0001..1.0 -, R]

* If SWOXYGEN=2, specify:
  Q10_MICROBIAL = 2.8        ! Relative increase in microbial respiration at temperature increase of 10 degrees C [1.0..4.0 -, R]
  SPECIFIC_RESP_HUMUS = 0.0016 ! Respiration rate of humus at 25 degrees C [0.0..1.0 kg O2/kg degrees C/d, R] 

**********************************************************************************

**********************************************************************************
* Part 12: Drought stress
  
* Switch for drought stress:
  SWDROUGHT = 1              ! 1 = Drought stress according to Feddes et al. (1978)
                             ! 2 = Drought stress according to De Jong van Lier et al. (2008)
                             ! 3 = Drought stress according to De Willigen et al. (2012)

* If SWDROUGHT=1, or in case of irrigation scheduling (SCHEDULE=1), specify:
  HLIM3H = -400.0            ! Pressure head below which water uptake reduction starts at high Tpot [-1d4..100 cm, R]
  HLIM3L = -500.0            ! Pressure head below which water uptake reduction starts at low Tpot [-1d4..100 cm, R]
  HLIM4 = -8000.0            ! No water extraction at lower soil water pressure heads [-1.6d4..100 cm, R]
  ADCRH = 0.5                ! Level of high atmospheric demand, corresponding to HLIM3H [0..5 cm/d, R]
  ADCRL = 0.1                ! Level of low atmospheric demand, corresponding to HLIM3L [0..5 cm/d, R]

**********************************************************************************

**********************************************************************************
* Part 13: Salt stress

* Switch salinity stress
  SWSALINITY = 1             ! 0 = No salinity stress
                             ! 1 = Maas and Hoffman reduction function

* If SWSALINITY=1, specify threshold and slope of Maas and Hoffman
  SALTMAX = 0.82             ! Threshold salt concentration in soil water  [0..100 mg/cm3, R] 
  SALTSLOPE = 0.07           ! Decline of root water uptake above threshold [0..1.0 cm3/mg, R] 

**********************************************************************************

**********************************************************************************
* Part xx: Compensation of root water uptake stress

* Switch for compensation root water uptake stress
  SWCOMPENSATE = 1           ! 0 = No compensation
                             ! 1 = Compensation according to Jarvis (1989)
                             ! 2 = Compensation according to Walsum (2019)

* Switch for selection of stressors to compensate
  SWSTRESSOR = 1             ! 1 = Compensation of all stressors
                             ! 2 = Compensation of drought stress
                             ! 3 = Compensation of oxygen stress
                             ! 4 = Compensation of salinity stress
                             ! 5 = Compensation of frost stress

* If SWCOMPENSATE=1, specify:
  ALPHACRIT = 0.7            ! Critical stress index for compensation of root water uptake [0.2..1 -, R]

**********************************************************************************

**********************************************************************************
* Part 14: Interception

* Switch for rainfall interception method:
  SWINTER = 3                ! 0 = No interception calculated
                             ! 1 = Agricultural crops, daily precipitation (Von Hoyningen-Hune and Braden)
                             ! 2 = Trees and forests, daily precipitation (Gash)
                             ! 3 = All vegetation, detailed precipitation (Rutter)

* In case of interception by Rutter (SWINTER=3) specify:
  SICCAPLAI = 0.0035         ! Interception storage per unit of LAI [0..1 cm/LAI, R]
  SICACT = 0.0               ! Initial amount of water stored on canopy [0..6 cm, R]

**********************************************************************************

**********************************************************************************
* Part 15: CO2-impact
*
* CO2-impact:
*    correction of photosynthesis as a function of atmospheric CO2 concentration (-)
*    correction of radiation use efficiency as a function of atmospheric CO2 concentration (-)
*    correction of transpiration as a function of atmospheric CO2 concentration (-)
*    values for C3 crops (potatoes, grassland, soybean) or C4 crops (maize)
*    actual CO2 concentration in atmosphere [ppm] in separate file atmospheric.co2
**********************************************************************************

* Switch for assimilation correction due to CO2 impact
  SWCO2 = 1                  ! 0 = No CO2 assimilation correction
                             ! 1 = CO2 assimilation correction

* if SWCO2=1, specify:
  SWATMOFIL = 1              ! 0 = CO2 concentrations are specified in current file
                             ! 1 = CO2 concentrations are specified in a separate file

  ATMOFIL = {{ATMOFIL}}      ! Alternative filename for atmosphere.co2

* Correction of photosynthesis as a function of atmospheric CO2 concentration
*   CO2  AMAX
  CO2AMAXTB =
  40.0 0.0
  360.0 1.0
  720.0 1.0
  1000.0 1.0
  2000.0 1.0
* End of table

* Correction of radiation use efficiency as a function of atmospheric CO2 concentration:
*   CO2  EFF
  CO2EFFTB =
  40.0 0.0
  360.0 1.0
  720.0 1.0
  1000.0 1.0
  2000.0 1.0
* End of table

* Correction of transpiration as a function of atmospheric CO2 concentration:
*   CO2  TRA
  CO2TRATB =  
  40.0 0.00
  360.0 1.00
  720.0 0.74
  1000.0 0.74
  2000.0 0.74
* End of table

**********************************************************************************

*** MANAGEMENT SECTION ***

**********************************************************************************
* Part 1: Management, other than irrigation, for instance pests, diseases or nutrients
 
* Switch for calculation of potential yield
  SWPOTRELMF = 2             ! 1 = Theoretical potential yield
                             ! 2 = Attainable yield

* In case of pest, diseases or nutrients, specify:
  RELMF = 1.0                ! Relative management factor to reduce theoretical potential yield to attainable yield [0..1 -, R]

**********************************************************************************

*** IRRIGATION SCHEDULING SECTION ***

**********************************************************************************
* Part 1: General

  SCHEDULE = {{SCHEDULE}}    ! Switch for application irrigation scheduling [Y=1, N=0] 

{{#SWITCH_SCHEDULE_OPTION_1}}
* If SCHEDULE=1, specify:
  STARTIRR = 16 04           ! Specify day and month at which irrigation scheduling starts [DD MM]
  ENDIRR = 30 09             ! Specify day and month at which irrigation scheduling stops [DD MM]
  CIRRS = 0.0                ! Solute concentration of irrigation water [0..100 mg/cm3, R]

* Switch for type of irrigation method: 
  ISUAS = 0                  ! 0 = Sprinkling irrigation
                             ! 1 = Surface irrigation

**********************************************************************************

**********************************************************************************
* Part 2: Irrigation time criteria

* Choose one of the following timing criteria options [1..6 -, I]:
  TCS = 1                    ! 1 = Ratio actual/potential transpiration
                             ! 2 = Depletion of Readily Available Water
                             ! 3 = Depletion of Totally Available Water
                             ! 4 = Depletion of absolute Water Amount
                             ! 6 = Fixed weekly irrigation
                             ! 7 = Pressure head
                             ! 8 = Moisture content

* Ratio actual/potential transpiration (TCS=1)
* Specify minimum of ratio actual/potential transpiration TREL [0..1 -, R] as function of crop development stage
   DVS_TC1  TREL
       0.0  0.85
       2.0  0.85
* End of table

* Switch for minimum time interval between irrigation applications
  TCSFIX = 1                 ! 0 = No minimum time interval
                             ! 1 = Define minimum time interval

* If TCSFIX = 1, specify:
  IRGDAYFIX = 7              ! Minimum number of days between irrigation applications [1..366 d, I]

**********************************************************************************

**********************************************************************************
* Part 3: Irrigation depth criteria

* Choose one of the following two options for irrigation depth:
  DCS = 2                    ! 1 = Back to field capacity
                             ! 2 = Fixed Irrigation Depth

* Specify fixed irrigation depth FID [0..400 mm, R] as function of crop development stage [0..2, R]:
   DVS_DC2   FID
       0.0  20.0
       2.0  20.0
* End of table

* Select minimum and maximum of irrigation depths:
  DCSLIM = 0                 ! Switch, limit range irrigation depth  [Y=1, N=0]

{{/SWITCH_SCHEDULE_OPTION_1}}
**********************************************************************************

* End of .crp file
